# grounding_2d_service GPU/SAM3 image (Osmo/Airflow-friendly).
#
# Slim CI/VLM image stays in docker/Dockerfile beside this file.
# This GPU Dockerfile is independent of detection-and-tracking (no sibling FROM).
#
# Build from the repository root:
#   docker build -t paidf-grounding-2d-sam3-service \
#     --build-arg PACKAGE_NAME=grounding-2d-service \
#     --build-arg RUNTIME_FLAVOR=sam3 \
#     --build-arg BASE_IMAGE=nvcr.io/nvidia/pytorch:26.07-py3 \
#     -f services/grounding_2d_service/docker/Dockerfile.gpu .
#
# Runtime expectation:
# - checkpoints mounted at MODEL_CACHE_PATH (default /models), not baked in;
# - SAM3 weights at /models/sam3;
# - VLM/LLM traffic stays on external endpoints;
# - NGC base image provides CUDA and PyTorch.

ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:26.07-py3@sha256:2140e699b3beaf7f96a0081fd9c9406bc3832b435cdb60dfa2d261f7d2f34a1c

FROM ${BASE_IMAGE} AS builder

ARG PACKAGE_NAME
ARG RUNTIME_FLAVOR=rfdetr
# When RUNTIME_FLAVOR=sam3, optionally install Meta's native sam3 package for
# --sam3-version sam3.1 Object Multiplex. Uses --no-deps because upstream pins
# numpy<2 while this image keeps numpy 2.x from the Transformers extra.
ARG INSTALL_NATIVE_SAM3=1
ARG SAM3_GIT_URL=https://github.com/facebookresearch/sam3.git
# Pin to an immutable commit (not a moving branch) for reproducible builds.
# Matches the SHA previously resolved from @main during the SAM 3.1 smoke image.
ARG SAM3_GIT_REF=5dd401d1c5c1d5c3eedff06d41b77af824517619

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-lc"]

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        nasm \
        pkg-config \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        libvpx-dev \
        xz-utils \
        yasm \
    && rm -rf /var/lib/apt/lists/*

# Build the manifest-pinned, LGPL-only media codec surface.
COPY scripts/media-toolchain.toml scripts/media_toolchain.py \
    scripts/ffmpeg_codec_policy.py scripts/build_restricted_ffmpeg.sh /tmp/media-build/
RUN python3 /tmp/media-build/media_toolchain.py ffmpeg-install --profile vp9-output

COPY --from=ghcr.io/astral-sh/uv:0.11.24@sha256:99ea34acedc870ba4ad11a1f540a1c04267c9f30aadc465a94406f52dfda2c36 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=0 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    UV_NO_DEV=1 \
    UV_PYTHON=/usr/bin/python3.12

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY packages ./packages
COPY services ./services
COPY scripts ./scripts

# Keep the service environment able to see CUDA-enabled PyTorch from the NGC base image.
# Skip PyPI CUDA wheels as well, otherwise they can shadow the base image libraries
# and break the preinstalled torch/torchvision imports.
RUN /usr/bin/python3.12 -m venv --system-site-packages /app/.venv

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-editable --package "${PACKAGE_NAME}" --extra "${RUNTIME_FLAVOR}" \
        --no-install-package av \
        --no-install-package opencv-python \
        --no-install-package opencv-python-headless \
        --no-install-package torch \
        --no-install-package torchvision \
        --no-install-package nvidia-cublas-cu12 \
        --no-install-package nvidia-cuda-cupti-cu12 \
        --no-install-package nvidia-cuda-nvrtc-cu12 \
        --no-install-package nvidia-cuda-runtime-cu12 \
        --no-install-package nvidia-cudnn-cu12 \
        --no-install-package nvidia-cufft-cu12 \
        --no-install-package nvidia-cufile-cu12 \
        --no-install-package nvidia-curand-cu12 \
        --no-install-package nvidia-cusolver-cu12 \
        --no-install-package nvidia-cusparse-cu12 \
        --no-install-package nvidia-cusparselt-cu12 \
        --no-install-package nvidia-nccl-cu12 \
        --no-install-package nvidia-nvjitlink-cu12 \
        --no-install-package nvidia-nvtx-cu12

# Native Meta SAM3 (Object Multiplex / SAM 3.1). Skip for rfdetr builds.
RUN --mount=type=cache,target=/root/.cache/pip \
    if [ "${RUNTIME_FLAVOR}" = "sam3" ] && [ "${INSTALL_NATIVE_SAM3}" = "1" ]; then \
      /app/.venv/bin/python -m pip install --no-cache-dir \
        "timm==1.0.17" "ftfy==6.1.1" "regex==2026.6.28" "iopath==0.1.10" \
        "tqdm==4.68.4" "huggingface_hub==1.23.0" \
      && /app/.venv/bin/python -m pip install --no-cache-dir --no-deps \
        "git+${SAM3_GIT_URL}@${SAM3_GIT_REF}" \
      && /app/.venv/bin/python -c "import sam3; from sam3 import build_sam3_predictor; print('native sam3 ok', sam3.__file__)"; \
    else \
      echo "Skipping native Meta sam3 install (RUNTIME_FLAVOR=${RUNTIME_FLAVOR}, INSTALL_NATIVE_SAM3=${INSTALL_NATIVE_SAM3})"; \
    fi

# Install the only cv2 provider from source with all general-purpose video
# backends disabled. Video I/O is owned by core + the restricted FFmpeg build.
RUN /app/.venv/bin/python scripts/media_toolchain.py python-install \
    --python /app/.venv/bin/python --component opencv-headless

# Build PyAV from source against /usr/local so generated overlays use the same
# controlled libvpx-vp9 encoder as superresolution.
RUN /app/.venv/bin/python scripts/media_toolchain.py python-install \
    --python /app/.venv/bin/python --component pyav

RUN /app/.venv/bin/python scripts/media_toolchain.py verify \
    --profile vp9-output --python /app/.venv/bin/python

FROM ${BASE_IMAGE} AS runtime

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-lc"]

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        python3.12 \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=from=builder,source=/opt/media-runtime,target=/tmp/media-runtime,readonly \
    cp -a /tmp/media-runtime/bin/. /usr/local/bin/ \
    && cp -a /tmp/media-runtime/lib/. /usr/local/lib/ \
    && mkdir -p /usr/share/oss-sources \
    && cp -a /tmp/media-runtime/oss-sources/. /usr/share/oss-sources/ \
    && ldconfig

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/scripts/prune_runtime_python.sh /tmp/prune-runtime-python
RUN bash /tmp/prune-runtime-python /app/.venv && rm /tmp/prune-runtime-python
COPY THIRD-PARTY-NOTICES /app/THIRD-PARTY-NOTICES
COPY LICENSE /app/LICENSE
COPY --from=builder /app/scripts/media-toolchain.toml /app/scripts/media_toolchain.py \
    /app/scripts/ffmpeg_codec_policy.py /app/scripts/

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    MODEL_CACHE_PATH=/models \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

RUN /app/.venv/bin/python /app/scripts/media_toolchain.py verify \
    --profile vp9-output --python /app/.venv/bin/python

RUN mkdir -p /models/rfdetr /models/sam3 /workspace \
    && chown -R ubuntu:ubuntu /models /workspace

USER ubuntu

ENTRYPOINT ["main"]
